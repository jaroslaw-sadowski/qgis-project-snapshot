[flake8]
max-line-length = 88
extend-ignore = E203
exclude = .git,dist,build,.venv,venv,vendor
per-file-ignores =
    tests/test_archive.py:E402
    tests/test_raster_archive.py:E402
    tests/test_archive_resources.py:E402
    # Bundled defusedxml: original formatting and Python 2/3 import branches.
    ElementTree.py:E501,F811
    common.py:E501
